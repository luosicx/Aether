<Page x:Class="Aether.Windows.Views.ConversationListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:design="clr-namespace:Aether.Windows.Design"
      xmlns:props="clr-namespace:Aether.Windows.Properties">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="{x:Static design:AetherColors.DeepSpace}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部栏：标题 + 新建会话 + 设置 -->
        <Border Grid.Row="0" Padding="16,12" Background="{x:Static design:AetherColors.LiquidGlass}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static props:Strings.AppTitle}" FontSize="28" FontWeight="SemiBold"
                           Foreground="{x:Static design:AetherColors.Starlight}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="{x:Static props:Strings.ConversationList_NewConversation}" Margin="8,0"
                        Command="{Binding ViewModel.CreateCommand}"
                        Foreground="{x:Static design:AetherColors.Starlight}"/>
                <Button Grid.Column="2" Content="{x:Static props:Strings.Settings_Title}"
                        Command="{Binding ViewModel.OpenSettingsCommand}"
                        Foreground="{x:Static design:AetherColors.Starlight}"/>
            </Grid>
        </Border>

        <!-- 会话列表 -->
        <ListView Grid.Row="1" ItemsSource="{Binding ViewModel.Conversations}"
                  Margin="16" Background="Transparent" BorderThickness="0"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 可点击的会话内容区域 -->
                        <Border Grid.Column="0" CornerRadius="12" Padding="12"
                                Background="{x:Static design:AetherColors.LiquidGlass}"
                                MouseLeftButtonUp="OnConversationClick"
                                Cursor="Hand">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <!-- 置顶图标 -->
                                    <TextBlock Text="★" FontSize="14" Margin="0,0,4,0"
                                               Foreground="{x:Static design:AetherColors.NebulaGlow}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{x:Static design:AetherColors.Starlight}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LastMessagePreview}" FontSize="12" Margin="0,4,0,0"
                                           Foreground="{x:Static design:AetherColors.DuskGray}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"/>
                                <TextBlock Text="{Binding UpdatedAt, Converter={StaticResource UnixTime}, ConverterParameter='MM-dd HH:mm'}"
                                           FontSize="10" Margin="0,2,0,0"
                                           Foreground="{x:Static design:AetherColors.DuskGray}"/>
                            </StackPanel>
                        </Border>
                        <!-- 置顶切换按钮 -->
                        <Button Grid.Column="1" Width="36" Height="36" Margin="4,0,0,0"
                                FontSize="16"
                                Command="{Binding ViewModel.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding Id}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="☆"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Content" Value="★"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- 删除按钮 -->
                        <Button Grid.Column="2" Content="✕" Width="36" Height="36" Margin="4,0,0,0"
                                FontSize="14"
                                Command="{Binding ViewModel.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding Id}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部错误栏 -->
        <Border Grid.Row="2" Padding="16,8"
                Background="{x:Static design:AetherColors.LiquidGlass}"
                Visibility="{Binding ViewModel.ErrorMessage, Converter={StaticResource NonEmptyToVis}}">
            <TextBlock Text="{Binding ViewModel.ErrorMessage}"
                       Foreground="#FFEF4444" FontSize="12"/>
        </Border>
    </Grid>
</Page>
