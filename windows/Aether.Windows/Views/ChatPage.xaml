<Page x:Class="Aether.Windows.Views.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:design="clr-namespace:Aether.Windows.Design">

    <Grid Background="{x:Static design:AetherColors.DeepSpace}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部栏 -->
        <Border Grid.Row="0" Padding="16,12" Background="{x:Static design:AetherColors.LiquidGlass}">
            <TextBlock Text="以太" FontSize="28" FontWeight="SemiBold"
                       Foreground="{x:Static design:AetherColors.Starlight}"/>
        </Border>

        <!-- 消息列表 -->
        <ListView Grid.Row="1" ItemsSource="{Binding ViewModel.Messages}"
                  Margin="16">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="16" Padding="12" Margin="0,4"
                            Background="{x:Static design:AetherColors.AetherPurple}"
                            HorizontalAlignment="Left" MaxWidth="480">
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                   Foreground="White"/>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 流式响应 -->
        <TextBlock Grid.Row="1" Text="{Binding ViewModel.StreamingText}"
                   Margin="16" TextWrapping="Wrap"
                   Foreground="{x:Static design:AetherColors.NebulaGlow}"/>

        <!-- 错误信息 -->
        <TextBlock Grid.Row="1" Text="{Binding ViewModel.ErrorMessage}"
                   Margin="16" VerticalAlignment="Bottom"
                   Foreground="#FFEF4444"/>

        <!-- 输入栏 -->
        <Grid Grid.Row="2" Margin="16" Background="{x:Static design:AetherColors.LiquidGlass}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="inputBox" Grid.Column="0"
                     KeyDown="OnInputKeyDown" Background="#80000000" Foreground="White"/>
            <Button Grid.Column="1" Content="发送" Margin="8,0,0,0"
                    Command="{Binding ViewModel.SendCommand}"
                    CommandParameter="{Binding Text, ElementName=inputBox}"/>
        </Grid>
    </Grid>
</Page>
