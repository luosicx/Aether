<Application x:Class="Aether.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Aether.Windows.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis"/>
        <conv:UnixTimeConverter x:Key="UnixTime"/>
    </Application.Resources>
</Application>
