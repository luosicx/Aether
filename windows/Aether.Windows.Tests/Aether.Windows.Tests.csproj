<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Aether.Windows.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
    <!-- StaFact：用于在 STA 线程上运行涉及 WPF DispatcherObject（如 FlowDocument）的单元测试 -->
    <PackageReference Include="Xunit.StaFact" Version="1.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aether.Windows\Aether.Windows.csproj" />
  </ItemGroup>

  <!-- 把 CI 已 stage 的 Rust DLL 复制到测试输出目录，让 Rust SSE 路径的用例真正执行；
       本地无 native 产物时条件不成立，测试按可用性自动跳过。 -->
  <ItemGroup>
    <None Include="..\Aether.Windows\Native\aether_core_ffi.dll" Condition="Exists('..\Aether.Windows\Native\aether_core_ffi.dll')">
      <Link>aether_core_ffi.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
