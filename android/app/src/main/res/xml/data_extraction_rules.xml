<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 数据提取规则：排除 DataStore 目录，防止 BFF Token 经备份/设备迁移泄露。
     注：allowBackup 已设为 false，此文件作为双重防护。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
