      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Delete conversation records: any conversation can be deleted from the conversation list; related data is removed from the local database."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 删除对话记录：可在会话列表中删除任意对话，相关数据会从本地数据库移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 刪除對話紀錄：可在對話列表中刪除任意對話，相關資料會從本地資料庫移除。"
          }
        }
      }
    },
    "2. 阿里云百炼 Qwen API：用于对话生成，用户输入文本会上传至阿里云服务端处理。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Alibaba Cloud Bailian Qwen API: used for chat generation; text you enter is uploaded to Alibaba Cloud servers for processing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
