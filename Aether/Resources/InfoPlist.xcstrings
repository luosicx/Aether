    "NSContactsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aether benötigt Zugriff auf Ihre Kontakte, um nach Kontakten zu suchen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aether needs access to your contacts to search for contacts"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aether necesita acceso a sus contactos para buscar contactos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aether a besoin d'accéder à vos contacts pour rechercher des contacts"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以太は連絡先を検索するために連絡先へのアクセスが必要です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이더는 연락처 검색을 위해 연락처 접근이 필요합니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以太需要访问通讯录以搜索联系人"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以太需要存取通訊錄以搜尋聯絡人"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aether muss Ihre Gesundheitsdaten (Herzfrequenz/Schlaf/Schritte) lesen, um personalisierte Empfehlungen zu geben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aether needs to read your health data (heart rate/sleep/steps) to provide personalized recommendations"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aether necesita leer sus datos de salud (frecuencia cardíaca/sueño/pasos) para proporcionar recomendaciones personalizadas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aether doit lire vos données de santé (fréquence cardiaque/sommeil/pas) pour fournir des recommandations personnalisées"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以太はパーソナライズされた提案を提供するため、健康データ（心拍数/睡眠/歩数）を読み取る必要があります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이더는 개인화된 권장 사항을 제공하기 위해 건강 데이터(심박수/수면/걸음 수)를 읽어야 합니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以太需要读取您的健康数据（心率/睡眠/步数）以提供个性化建议"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以太需要讀取您的健康資料（心率/睡眠/步數）以提供個人化建議"
          }
        }
      }
    },
