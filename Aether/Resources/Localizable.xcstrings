            "state": "new",
            "value": ""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 健康数据：包括心率、睡眠时长、步数等，仅在用户明确授权 HealthKit 后读取，用于生成个性化健康洞察。"
          }
        },
