            "state": "new",
            "value": ""
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Health data: includes heart rate, sleep duration, steps, etc., read only after you explicitly authorize HealthKit, used to generate personalized health insights."
          }
